  xStr: string;
  I: integer;
begin
  // 除錯用
  SL := TStringList.Create;
  for I := 0 to ReportData.FieldCount - 1 do begin
    xStr := xStr + ReportData.Fields[I].DisplayLabel + ',';
  end;
  //CopyTOClipboard(xStr);
  FreeAndNil(SL);
  // 自用
  Label_frxReportName.Visible := not Label_frxReportName.Visible;
